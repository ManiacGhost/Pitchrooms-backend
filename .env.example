# ==========================================================================
# PitchRooms API — environment
# Copy to .env and fill in. NEVER commit .env.
# ==========================================================================

# --------------------------------------------------------------------------
# CENTRAL DNS  — the one knob that moves the whole API between environments.
# Everything the API emits (file URLs, receipt links, email links, webhook
# callback URLs, OpenAPI server URL) is built from APP_DNS.
# Local:      http://localhost:8080
# Staging:    https://api-staging.pitchrooms.com
# Production: https://api.pitchrooms.com
# --------------------------------------------------------------------------
APP_DNS=http://localhost:8080

# The frontend's own DNS. Used for links inside emails/notifications
# (e.g. "open the pitch room") and as the default CORS origin.
FRONTEND_DNS=http://localhost:5173

# Extra allowed browser origins, comma separated. FRONTEND_DNS is always
# allowed and does not need repeating here.
CORS_EXTRA_ORIGINS=

APP_NAME=PitchRooms
APP_ENV=local
# Never leave this on in production — it returns stack traces to clients.
APP_DEBUG=true
APP_TIMEZONE=UTC
API_PREFIX=/api/v1

# --------------------------------------------------------------------------
# Database (Hostinger: hostname is usually localhost, user/db are prefixed)
# --------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pitchrooms
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --------------------------------------------------------------------------
# Auth — generate with:  php bin/keygen.php
# --------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ISSUER=pitchrooms-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --------------------------------------------------------------------------
# Scheduler — cron runs in code, not in the hosting panel.
#   1) inline: due jobs run after an API response (no external trigger)
#   2) http:   POST {APP_DNS}/api/v1/internal/scheduler/tick  + X-Scheduler-Key
#   3) cli:    php bin/scheduler.php --daemon
# --------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INLINE=true
SCHEDULER_KEY=change-me-scheduler-key
SCHEDULER_MIN_INTERVAL=60
SCHEDULER_MAX_JOBS_PER_TICK=25

# --------------------------------------------------------------------------
# Meetings (Jitsi)
# --------------------------------------------------------------------------
# JaaS (8x8): domain is 8x8.vc, APP_ID is the vpaas-magic-cookie-… value, and
# API_KEY is the full key id "<appId>/<keyId>". The key path may be relative to
# the project root — prefer that over an absolute path so deploys still work.
# Self-hosted: set JITSI_DOMAIN + JITSI_API_KEY (shared secret) and no key path.
JITSI_DOMAIN=8x8.vc
JITSI_APP_ID=
JITSI_API_KEY=
JITSI_PRIVATE_KEY_PATH=storage/keys/privatekey.pk
JITSI_TOKEN_TTL=7200

# --------------------------------------------------------------------------
# Uploads (stored outside the webroot, served through signed URLs)
# --------------------------------------------------------------------------
UPLOAD_MAX_BYTES=15728640
UPLOAD_DIR=storage/uploads
FILE_URL_TTL=900

# --------------------------------------------------------------------------
# Mail — Brevo
#   log       write to storage/logs, send nothing (local default)
#   brevo     Brevo SMTP relay + SMTP key   <- what you are setting up
#   brevo_api Brevo HTTP API + xkeysib key  (use if the host blocks port 587)
#   smtp      any other SMTP server
#   none      drop silently
#
# For MAIL_DRIVER=brevo, from Brevo > SMTP & API > SMTP:
#   SMTP_USER = your Brevo login email (shown as "Login" there)
#   SMTP_PASS = the SMTP key  (NOT your Brevo account password)
# MAIL_FROM must be a sender you have verified in Brevo, or sends are rejected.
#
# Test it:  php bin/mailtest.php you@example.com --debug
# --------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM=no-reply@pitchrooms.com
MAIL_FROM_NAME=PitchRooms
MAIL_REPLY_TO=

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_TIMEOUT=20

# Only for MAIL_DRIVER=brevo_api and/or SMS_DRIVER=brevo (an xkeysib-… key).
BREVO_API_KEY=

# Transactional SMS: log | brevo | none.
# The pitch room entry gate sends a mobile OTP — on "log" it is written to the
# log file instead of being delivered.
SMS_DRIVER=log
SMS_FROM=PITCHR

# --------------------------------------------------------------------------
# Payments (stripe | razorpay | manual)
# --------------------------------------------------------------------------
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=USD
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# Business rules (server-enforced; the frontend only displays them)
# --------------------------------------------------------------------------
SHORTLIST_LIMIT=5
OTP_TTL=600
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_OTP=5
RATE_LIMIT_MESSAGE=60
