# PitchRooms API — Apache (Hostinger) front controller rules

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through to PHP. Some Apache/CGI setups
    # strip it, which would break every authenticated request.
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    # Force HTTPS in production (harmless locally over http).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Everything that is not a real file goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes
